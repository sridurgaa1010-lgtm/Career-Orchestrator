{
  "name": "career-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/career.db"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        }
      }
    }
  }
}
